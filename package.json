{
  "name": "pphelper",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "start": "electron .",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "protobufjs": "^8.8.0"
  },
  "build": {
    "appId": "com.nkrease.pphelper",
    "productName": "pphelper",
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/src/**/*.js",
      "src/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "proto",
        "to": "proto",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": null,
      "hardenedRuntime": false
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
